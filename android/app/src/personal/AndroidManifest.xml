<?xml version="1.0" encoding="utf-8"?>
<!-- personal build only: talk to the founder's own Mac over Tailscale. The public build has no internet. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- personal build (sideloaded, not on Play): exact reminders without asking. Play allows this only for alarm/calendar apps -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <application>
        <!-- "Type into the box for me": personal build only until the Google Play decision -->
        <service
            android:name="com.whispercppdemo.overlay.PasteService"
            android:exported="false"
            android:label="@string/paste_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/paste_service" />
        </service>
    </application>
</manifest>
